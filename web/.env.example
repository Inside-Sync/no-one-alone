VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# mock (default) | firebase: read Firestore and run the real emergency flow through core-api (docs/contract.md)
VITE_DATA_SOURCE=mock
# Firebase web config (public by design, contract section 6): Firebase console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=no-one-alone-511616.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=no-one-alone-511616
VITE_FIREBASE_STORAGE_BUCKET=no-one-alone-511616.firebasestorage.app
VITE_FIREBASE_APP_ID=
# Only if the Hosting rewrite to Cloud Run fails: the core-api run.app URL (default: same origin /api)
VITE_API_BASE=
# Dev server only (not VITE_): where /api is proxied; default http://localhost:8080
API_PROXY=
